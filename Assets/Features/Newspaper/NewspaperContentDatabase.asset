  - "\u042D\u0442\u043E\u0442 \u0442\u0435\u043A\u0441\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
    \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
    \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043D\u0430\u043C \u043D\u0435
    \u043B\u0435\u043D\u044C \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u0432\u0441\u044E \u044D\u0442\u0443 \u0433\u0430\u0437\u0435\u0442\u0443 \u0438
    \u043F\u0440\u043E\u0434\u0443\u043C\u044B\u0432\u0430\u0442\u044C \u043C\u0438\u0440
    \u0438\u0433\u0440\u044B, \u043D\u043E \u043D\u0430\u043C \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u0435\u0439\u0448\u0435
    \u043B\u0435\u043D\u044C, \u0442\u0430\u043A \u0447\u0442\u043E \u0434\u0430\u0436\u0435
    \u043D\u0435 \u043D\u0430\u0434\u0435\u0439\u0442\u0435\u0441\u044C. \u0412\u044B
    \u0441\u043B\u044B\u0448\u0430\u043B\u0438 It Doesn't Matter \u043E\u0442 TLT?
    \u041E\u0444\u0438\u0433\u0435\u043D\u043D\u0430\u044F \u043F\u0435\u0441\u043D\u044F,
    \u043D\u043E \u043C\u043E\u0439 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A
    \u043F\u043E \u0440\u0430\u0431\u043E\u0442\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442
    \u0428\u0430\u043C\u0430\u043D\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0432 \u0438\u0433\u0440\u0435 \u0435\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442.
    \u041A\u0441\u0442\u0430\u0442\u0438 \u0428\u0430\u043C\u0430\u043D\u0430 \u0442\u043E\u0436\u0435
    \u043D\u0435 \u0431\u0443\u0434\u0435\u0442, \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C
    ;)"
  - "\u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
    \u0441 \u0433\u043E\u0440\u044F\u0447\u0435\u0439 \u043B\u0438\u043D\u0438\u0438
    \u043F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u0430: \u0414\u043C\u0438\u0442\u0440\u0438\u0439
    \u0414\u0443\u0434\u043A\u0438\u043D: \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
    \u041C\u0438\u0441\u0442\u0435\u0440 \u041F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442,
    \u0432 \u043E\u0431\u0449\u0435\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
    \u0442\u0430\u043A\u0430\u044F: \u0443 \u043C\u0435\u043D\u044F \u0447\u0435\u0442\u0432\u0435\u0440\u043E
    \u0434\u0435\u0442\u0435\u0439, \u043F\u043B\u044E\u0441 \u0435\u0449\u0435 \u0447\u0435\u0442\u0432\u0435\u0440\u043E
    \u0434\u0435\u0442\u0435\u0439, \u043F\u043B\u044E\u0441 \u0435\u0449\u0435 \u0447\u0435\u0442\u0432\u0435\u0440\u043E
    \u0434\u0435\u0442\u0435\u0439. \u0412 \u043E\u0431\u0449\u0435\u043C \u0434\u0435\u043B\u0430\u0435\u043C
    \u0434\u0435\u0442\u0435\u0439. \u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u043C
    \u0433\u043E\u0441\u0437\u0430\u043A\u0430\u0437 \u043D\u0430 \u0434\u0435\u0442\u0435\u0439.
    \u041C\u0435\u043D\u044F \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442
    \u043A\u0443\u0434\u0430 \u0434\u0435\u0442\u044C \u0434\u0435\u0442\u0435\u0439
    \u041C\u0438\u0441\u0442\u0435\u0440 \u041F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442:
    \u0427\u0442\u043E \u043D\u0430\u0441\u0447\u0435\u0442 \u0434\u0435\u0442\u0435\u0439,
    \u0442\u043E \u044F \u0438\u0445 \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C
    \u0435\u043C \u043A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E, \u0434\u0430\u0436\u0435
    \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0441\u0435\u0433\u043E\u0434\u043D\u044F"
  - "\"\u042D\u0442\u043E, \u044D\u0442\u043E \u0440\u043E\u0432\u043D\u043E \u0441\u044B\u043D\u043E\u043A,
    \u044D\u0442\u043E, \u044D\u0442\u043E, \u044D\u0442\u043E \u0440\u043E\u0432\u043D\u043E,
    \u044D\u0442\u043E \u0440\u043E\u0432\u043D\u043E \u0441\u044B\u043D\u043E\u043A,
    \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C...\u042D\u0442\u043E, \u044D\u0442\u043E
    \u0440\u043E\u0432\u043D\u043E, \u044D\u0442\u043E \u0440\u043E\u0432\u043D\u043E,
    \u0441\u044B\u043D\u043E\u043A, \u044D\u0442\u043E \u0440\u043E\u0432\u043D\u043E.
    \u042F \u0437\u043D\u0430\u044E \u0447\u0442\u043E \u0442\u044B \u0435\u0449\u0435
    \u043D\u043E\u0432\u0438\u0447\u043E\u043A \u0432 \u0445\u043E\u0434\u044C\u0431\u0435,
    \u043D\u043E \u044D\u0442\u043E, \u044D\u0442\u043E \u0440\u043E\u0432\u043D\u043E
    \u0441\u044B\u043D\u043E\u043A\" - \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u0442\u0435\u0446,
    \u043F\u043E\u0436\u0435\u043B\u0430\u0432\u0448\u0438\u0439 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
    \u043D\u0435\u043D\u0430\u0437\u0432\u0430\u043D\u043D\u044B\u043C"
  - "-\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u0447\u0442\u043E \u044F \u0438\u0437 \u0425\u0430\u0431\u0430\u0440\u043E\u0432\u0441\u043A\u0430,
    \u0435\u0445\u0430\u043B 9000 \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432,
    \u0447\u0435\u0440\u0435\u0437 \u0432\u0441\u044E \u0441\u0442\u0440\u0430\u043D\u0443...
    -\u0417\u0430 \u044F\u0439\u0446\u043E\u043C! -\u041B\u0435\u043E\u043D\u0438\u0434
    \u0410\u0440\u043A\u0430\u0434\u044C\u0435\u0432\u0438\u0447, \u043C\u0435\u043D\u044F
    \u0436\u0435 \u0446\u0435\u043B\u043E\u0435 \u043F\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435...\u041C\u0435\u043D\u044F
    \u0412\u0438\u043A\u0442\u043E\u0440 \u041E\u0431\u0440\u0430\u043C\u043E\u0432\u0438\u0447,
    \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0432\u0440\u0430\u0447 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
    \u043D\u0435 \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u0442\u044C... -\u042F\u0439\u0446\u043E!
    -\u042D\u0442\u043E \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0448\u0443\u0442\u043A\u0430?
    -\u041D\u0435\u0442, \u044D\u0442\u043E \u043D\u0435 \u0448\u0443\u0442\u043A\u0430!
    \u0412 \u0425\u0430\u0431\u0430\u0440\u043E\u0432\u0441\u043A\u0435 \u0442\u0430\u043A\u043E\u0433\u043E
    \u043D\u0435\u0442 \u043D\u0438 \u0443 \u043A\u043E\u0433\u043E, \u0442\u043E\u043B\u044C\u043A\u043E
    \u0443 \u0412\u0430\u0441 \u0431\u0443\u0434\u0435\u0442!"
  - "\u0412\u044B \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u043B\u0438\u0441\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
    \u043F\u0435\u043B\u044C\u043C\u0435\u043D\u044C \u0438\u043C\u0435\u0435\u0442
    \u0444\u043E\u0440\u043C\u0443 \u0448\u0430\u0440\u0430 \u0438\u0437 \u0442\u0435\u0441\u0442\u0430
    \u0441 \u0431\u043E\u0440\u043E\u0437\u0434\u043A\u043E\u0439? \"\u0412\u043D\u0435\u0448\u043D\u0435
    \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043B \u043F\u043B\u0430\u043D\u0435\u0442\u0443
    \u0421\u0430\u0442\u0443\u0440\u043D, \u043E\u043D \u043E\u0431\u043B\u0430\u0434\u0430\u043B
    \u0442\u043E\u0439 \u0436\u0435 \u043F\u043E\u043B\u043D\u043E\u0442\u043E\u0439
    \u0441\u0438\u043B\u044B...\" \u041D\u043E \u0432 \u0447\u0451\u043C \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u043B\u0430\u0441\u044C
    \u0435\u0433\u043E \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0441\u0438\u043B\u0430 \u0438 \u043E\u0442\u043A\u0443\u0434\u0430 \u043D\u0430\u0448\u0438
    \u0434\u0430\u043B\u0451\u043A\u0438\u0435 \u043F\u0440\u0435\u0434\u043A\u0438
    \u0431\u0435\u0437 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u0432 \u0438 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u043E\u0432
    \u043C\u043E\u0433\u043B\u0438 \u0437\u043D\u0430\u0442\u044C, \u043A\u0430\u043A
    \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0421\u0430\u0442\u0443\u0440\u043D?
    \u041E\u0434\u043D\u0430\u043A\u043E \u0433\u043B\u0430\u0432\u043D\u0430\u044F
    \u0441\u0438\u043B\u0430 \u043F\u0435\u043B\u044C\u043C\u0435\u043D\u0435\u0439
    \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u0430\u0441\u044C \u0432 \u0438\u0445
    \u0444\u043E\u0440\u043C\u0435..."
  - "\u0412 \u0432\u044B\u043F\u0443\u0441\u043A\u0435\_#\u0421\u0430\u043C\u044B\u0435\u0428\u043E\u043A\u0438\u0440\u0443\u044E\u0449\u0438\u0435\u0413\u0438\u043F\u043E\u0442\u0435\u0437\u044B:
    \u041A\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E
    \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0442 \u043D\u0430\u043C \u0438\u0437
    \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0438?
    \u041F\u043E\u0447\u0435\u043C\u0443 \u043F\u0440\u0438\u0448\u0435\u043B\u044C\u0446\u044B
    \u043C\u043E\u0433\u0443\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
    \u043A\u0440\u0430\u0439\u043D\u0435 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u043C\u0438?
    \u041A\u0430\u043A \u0411\u043E\u0433\u0438 \u0441\u043E \u0437\u0432\u0435\u0437\u0434
    \u043E\u0441\u0432\u0430\u0438\u0432\u0430\u043B\u0438 \u043D\u0430\u0448\u0443
    \u043F\u043B\u0430\u043D\u0435\u0442\u044B? \u041F\u043E\u0447\u0435\u043C\u0443
    \u0417\u0435\u043C\u043B\u044F \u0442\u0435\u0440\u044F\u0435\u0442 \u0441\u0432\u043E\u044E
    \u043C\u0430\u0441\u0441\u0443? \u041A\u0430\u043A\u0438\u0435 \u0438\u043C\u0435\u043D\u043D\u043E
    \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u044F\u043D\u0435
    \u0434\u043E\u0431\u044B\u0432\u0430\u044E\u0442 \u043D\u0430 \u0417\u0435\u043C\u043B\u0435?
    \L"
  - "\u0412 \u044D\u0442\u043E\u043C \u0432\u044B\u043F\u0443\u0441\u043A\u0435:
    \u0412\u0435\u043B\u0438\u043A\u0430\u044F \u0442\u0430\u0439\u043D\u0430 \u0440\u0443\u0441\u0441\u043A\u0438\u0445
    \u043E\u0437\u0435\u0440. \u041F\u043E\u0447\u0435\u043C\u0443 \u043E\u0434\u043D\u0438
    \u0438\u0441\u0446\u0435\u043B\u044F\u044E\u0442, \u0430 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043C\u043E\u0433\u0443\u0442 \u0443\u0431\u0438\u0442\u044C? \u041C\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B. \u0427\u0442\u043E \u043D\u0430\u0445\u043E\u0434\u044F\u0442
    \u0443\u0447\u0435\u043D\u044B\u0435 \u043D\u0430 \u0434\u043D\u0435 \u043E\u0437\u0435\u0440
    \u0438 \u0431\u043E\u043B\u043E\u0442? \u0424\u0435\u043D\u043E\u043C\u0435\u043D
    \u0436\u0438\u0432\u043E\u0439 \u0438 \u043C\u0435\u0440\u0442\u0432\u043E\u0439
    \u0432\u043E\u0434\u044B. \u041C\u043E\u0436\u043D\u043E \u043B\u0438 \u0435\u0435
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u043E\u0432 \u0438 \u0435\u0441\u0442\u044C
    \u043B\u0438 \u0443 \u0432\u043E\u0434\u044B \u043F\u0430\u043C\u044F\u0442\u044C?
    \u0410\u043D\u0442\u0438\u043C\u0438\u0440 \u043D\u0430 \u0434\u043D\u0435. \u041F\u043E\u0447\u0435\u043C\u0443
    \u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u0432\u0435\u0440\u0438\u043B\u0438,
    \u0447\u0442\u043E \u043E\u0437\u0435\u0440\u0430 \u2013 \u044D\u0442\u043E \u043F\u043E\u0440\u0442\u0430\u043B\u044B
    \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u043C\u0438\u0440?"
  - "\u0414\u0423\u041D\u041A\u0410\u041D!!!!!!!!!!!!"
  - "\"\u0412.\u0414.\u0413\u0430\u0441\u0442\u0435\u0440 \u0414\u0435\u043B\u044C\u0442\u0430\u0440\u0443\u043D
